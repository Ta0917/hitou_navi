# Local development only. Replace all database password placeholders.
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=replace_with_local_app_password
# Match MYSQL_* above; URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://app_user:replace_with_local_app_password@db:3306/app_db
CORS_ORIGIN=http://localhost
# Keep false in public environments. See README for development-only access.
ENABLE_ADMIN_API=false
ADMIN_API_TOKEN=
